# Bắt buộc cấu hình URL backend; app không có chế độ demo.
# Tạo mobile/.env.local và dùng IP LAN của máy chạy backend khi thử trên điện thoại.
# Thay IP bên dưới bằng IPv4 Wi-Fi của máy (xem bằng ipconfig).
# Điện thoại và máy tính phải cùng Wi-Fi. Khởi động lại Expo sau khi sửa.
EXPO_PUBLIC_API_URL=http://192.168.1.181:3000/api/v1
